# Copiez ce fichier en « .env » (non versionné) et adaptez les valeurs.
# Lu par le proxy du serveur de dev (proxy.conf.mjs) au lancement de « npm start ».

# URL racine de votre Jenkins, sans /job/... (obligatoire pour utiliser le proxy de dev)
JENKINS_URL=https://jenkins.mon-entreprise.fr

# Mettre à true pour accepter un certificat auto-signé ou d'autorité interne (optionnel)
# JENKINS_INSECURE=true
